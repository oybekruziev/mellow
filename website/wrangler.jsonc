// Deploys the landing page as a Cloudflare Worker with static assets.
//   cd website && npx wrangler deploy
// worker.js serves the DMG and latest.json from R2 under /download/, so
// downloads work on every domain below (and on workers.dev).
// stats.js counts visits and downloads into D1 for /admin (password: the ADMIN_PASSWORD secret).
{
  "name": "mellow-website",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "mellow-downloads" }],
  "d1_databases": [{
    "binding": "STATS",
    "database_name": "mellow-stats",
    "database_id": "a9e1055a-b0e2-4360-9fb9-bf8a48794668",
    "migrations_dir": "migrations"
  }],
  "workers_dev": true,
  "routes": [
    { "pattern": "bemellow.cc", "custom_domain": true },
    { "pattern": "www.bemellow.cc", "custom_domain": true }
  ]
}
